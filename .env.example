# Copy of the local environment file.
# setup.sh creates .env from this file when .env does not exist.
# Put real values only in .env. Never commit .env.

# Key from the organizers. Leave this empty in the repository.
OPENROUTER_API_KEY=

# OpenAI-compatible API root. Change it only for another provider.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model id from https://openrouter.ai/models (provider/model-name).
AI_MODEL=
